# Create React App only exposes variables that start with REACT_APP_.
# This public base URL is optional. The app defaults to https://api.github.com.
REACT_APP_GITHUB_API_BASE_URL=https://api.github.com

# Optional mailbox for the FAQ contact form. Leave empty to keep the form from claiming a message was sent.
# Do not put a GitHub token in this file. CRA inlines every REACT_APP_* value into the browser bundle.
REACT_APP_SUPPORT_EMAIL=
